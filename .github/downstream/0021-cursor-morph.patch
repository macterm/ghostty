+    /// `cursor-morph`: the shape of a block cursor while it glides, a
+    /// comet. Its round head is on the glide's rect and has the rect's
+    /// area. Its body gets thinner back to a round tail of half the
+    /// head's radius: two discs and the lines that touch both. The
+    /// tail is where the head was `lag` of the glide ago, so the comet
+    /// is long while the cursor is fast, and points the way it really
+    /// moves, also on a diagonal. The shaders fill the comet mixed with
+    /// the rect by `weight` (`Uniforms.cursor_comet`), so the block turns
+    /// into the comet as it sets out and back into the block before it
+    /// lands. A move of one row or less, such as typing or a new line,
+    /// has no comet; a move of two rows or more has the full comet.
+    pub const Comet = struct {
+        /// The centers of the head and the tail, in grid pixels.
+        head: [2]f32,
+        tail: [2]f32,
+        head_radius: f32,
+        tail_radius: f32,
+        /// 0 is the rect and 1 the comet.
+        weight: f32,
+        /// Where the tail is from the head at full weight.
+        body: [2]f32,
+
+        /// The fraction of the glide that the tail is behind the head.
+        pub const lag: f64 = 0.3;
+        /// The longest the body gets, head center to tail center, in
+        /// cell heights.
+        pub const max_length: f32 = 2.5;
+        /// The tail's radius over the head's.
+        pub const tail_ratio: f32 = 0.5;
+        /// The fraction of the glide in which the rect turns into the
+        /// comet, and the fraction from which it turns back.
+        pub const grow_until: f64 = 0.1;
+        pub const settle_from: f64 = 0.7;
+
+        /// What a retarget carries into the next glide: where the tail is
+        /// from the head at full weight, and the weight. The new glide
+        /// sets out from the head, so the comet goes on with no jump.
+        pub const Carry = struct {
+            tail: [2]f32 = .{ 0, 0 },
+            weight: f32 = 0,
+        };
+
+        fn carry(self: Comet) Carry {
+            return .{ .tail = self.body, .weight = self.weight };
+        }
+
+        /// The comet `elapsed_s` into a glide from `from` to `to`, or null
+        /// where the cursor is its rect: at rest, as it sets out and lands,
+        /// and for a short move. `carried` is what the glide before it left.
+        fn at(from: [4]f32, to: [4]f32, elapsed_s: f64, cell_h: f32, carried: Carry) ?Comet {
+            const t = std.math.clamp(elapsed_s / duration_s, 0.0, 1.0);
+            if (t >= 1 or cell_h <= 0) return null;
+
+            const from_c = center(from);
+            const to_c = center(to);
+            const d: [2]f32 = .{ to_c[0] - from_c[0], to_c[1] - from_c[1] };
+            const amount = std.math.clamp(@sqrt(d[0] * d[0] + d[1] * d[1]) / cell_h - 1.0, 0.0, 1.0);
+            const grow: f32 = @floatCast(smoothstep(0, grow_until, t));
+            const settle: f32 = @floatCast(1.0 - smoothstep(settle_from, 1, t));
+            const weight = (carried.weight + (amount - carried.weight) * grow) * settle;
+            if (weight <= 0) return null;
+
+            // The head is on the glide's rect, the tail where the head was
+            // `lag` ago. A carried tail joins that path within `lag`. The
+            // body gets shorter with the cube of the weight, so the body
+            // is gone before the comet turns back into the block. A body
+            // mixed with the block draws a sharp point.
+            const rect = rectAt(from, to, elapsed_s);
+            const head = center(rect);
+            const behind: f32 = @floatCast(ease(@max(t - lag, 0)));
+            const fade: f32 = @floatCast(1.0 - ease(@min(t / lag, 1)));
+            var v: [2]f32 = undefined;
+            for (&v, from_c, d, carried.tail, head) |*out, c, step_d, off, h| {
+                out.* = c + step_d * behind + off * fade - h;
+            }
+            const len = @sqrt(v[0] * v[0] + v[1] * v[1]);
+            const max_len = max_length * cell_h;
+            const scale = if (len > max_len) max_len / len else 1;
+            const body: [2]f32 = .{ v[0] * scale, v[1] * scale };
+            const shown = weight * weight * weight;
+
+            const head_radius = @sqrt(rect[2] * rect[3] / std.math.pi);
+            return .{
+                .head = head,
+                .tail = .{ head[0] + body[0] * shown, head[1] + body[1] * shown },
+                .head_radius = head_radius,
+                .tail_radius = head_radius * tail_ratio,
+                .weight = weight,
+                .body = body,
+            };
+        }
+
+        fn smoothstep(edge0: f64, edge1: f64, x: f64) f64 {
+            const s = std.math.clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
+            return s * s * (3.0 - 2.0 * s);
+        }
+    };
 };
 
+test "CursorGlide comet flies a long move head first and lands as the block" {
+    const testing = std.testing;
+    const h: f32 = 20;
+    const from: [4]f32 = .{ 0, 0, 10, 20 };
+    const to: [4]f32 = .{ 400, 0, 10, 20 };
+    const d = CursorGlide.duration_s;
+
+    // It sets out as the block and lands as the block.
+    try testing.expect(CursorGlide.Comet.at(from, to, 0, h, .{}) == null);
+    try testing.expect(CursorGlide.Comet.at(from, to, d, h, .{}) == null);
+    try testing.expect(CursorGlide.Comet.at(from, to, 10, h, .{}) == null);
+
+    // On the way the head is on the glide's rect, with the block's
+    // area, and the tail is behind it on the row, smaller, never past
+    // the start and never more than the longest body. As the comet turns
+    // back into the block, its body gets shorter.
+    var longest: f32 = 0;
+    var i: usize = 1;
+    while (i < 20) : (i += 1) {
+        const t = d * @as(f64, @floatFromInt(i)) / 20.0;
+        const c = CursorGlide.Comet.at(from, to, t, h, .{}).?;
+        const rect = CursorGlide.rectAt(from, to, t);
+        try testing.expectApproxEqAbs(rect[0] + 5, c.head[0], 0.001);
+        try testing.expectEqual(@as(f32, 10), c.head[1]);
+        try testing.expectEqual(@as(f32, 10), c.tail[1]);
+        try testing.expectApproxEqAbs(@as(f32, 200), std.math.pi * c.head_radius * c.head_radius, 0.01);
+        try testing.expectApproxEqAbs(c.head_radius / 2, c.tail_radius, 0.001);
+        try testing.expect(c.tail[0] <= c.head[0] and c.tail[0] >= 5);
+        try testing.expect(c.head[0] - c.tail[0] <= CursorGlide.Comet.max_length * h + 0.001);
+        try testing.expect(c.weight > 0 and c.weight <= 1);
+        longest = @max(longest, c.head[0] - c.tail[0]);
+    }
+    try testing.expectApproxEqAbs(CursorGlide.Comet.max_length * h, longest, 0.001);
+
+    // Full from a tenth of the glide to seven tenths, then it goes back.
+    try testing.expectApproxEqAbs(@as(f32, 1), CursorGlide.Comet.at(from, to, d * 0.1, h, .{}).?.weight, 0.0001);
+    try testing.expectApproxEqAbs(@as(f32, 1), CursorGlide.Comet.at(from, to, d * 0.7, h, .{}).?.weight, 0.0001);
+    const late = CursorGlide.Comet.at(from, to, d * 0.95, h, .{}).?;
+    try testing.expect(late.weight < 0.1);
+    try testing.expect(late.head[0] - late.tail[0] < 0.1 * CursorGlide.Comet.max_length * h);
+
+    // Moving the other way is the mirror image.
+    const ahead = CursorGlide.Comet.at(from, to, d * 0.3, h, .{}).?;
+    const back = CursorGlide.Comet.at(to, from, d * 0.3, h, .{}).?;
+    try testing.expectApproxEqAbs(ahead.head[0] - ahead.tail[0], back.tail[0] - back.head[0], 0.001);
+}
+
+test "CursorGlide comet is long enough to see and points the way it moves" {
+    const testing = std.testing;
+    const h: f32 = 20;
+    const from: [4]f32 = .{ 0, 0, 10, 20 };
+    const d = CursorGlide.duration_s;
+
+    // A jump of three rows: at a 60 fps frame a third of the way in,
+    // the body is more than a row and a half.
+    const rows3 = CursorGlide.Comet.at(from, .{ 0, 60, 10, 20 }, d * 0.3, h, .{}).?;
+    try testing.expect(rows3.head[1] - rows3.tail[1] > 1.5 * h);
+    try testing.expectEqual(rows3.head[0], rows3.tail[0]);
+
+    // A long diagonal jump (27 rows, 95 columns) is a comet along the
+    // diagonal, at its longest for most of the glide.
+    const to: [4]f32 = .{ 950, 540, 10, 20 };
+    var i: usize = 1;
+    while (i <= 5) : (i += 1) {
+        const t = d * @as(f64, @floatFromInt(i)) / 8.0;
+        const c = CursorGlide.Comet.at(from, to, t, h, .{}).?;
+        const vx = c.head[0] - c.tail[0];
+        const vy = c.head[1] - c.tail[1];
+        try testing.expectApproxEqAbs(CursorGlide.Comet.max_length * h, @sqrt(vx * vx + vy * vy), 0.001);
+        try testing.expectApproxEqAbs(@as(f32, 950.0 / 540.0), vx / vy, 0.001);
+    }
+
+    // Typing, two columns and a new line: no comet at all.
+    for ([_][4]f32{ .{ 10, 0, 10, 20 }, .{ 20, 0, 10, 20 }, .{ 0, 20, 10, 20 } }) |near| {
+        i = 0;
+        while (i <= 10) : (i += 1) {
+            const t = d * @as(f64, @floatFromInt(i)) / 10.0;
+            try testing.expect(CursorGlide.Comet.at(from, near, t, h, .{}) == null);
+        }
+    }
+
+    // A move of one and a half rows has half the weight.
+    const half = CursorGlide.Comet.at(from, .{ 0, 30, 10, 20 }, d * 0.5, h, .{}).?;
+    try testing.expectApproxEqAbs(@as(f32, 0.5), half.weight, 0.001);
+}
