+test "CursorGlide morph follows the speed and leaves typing alone" {
+    const testing = std.testing;
+    const cell_h: f32 = 20;
+    const from: [4]f32 = .{ 0, 0, 10, cell_h };
+    const d = CursorGlide.duration_s;
+
+    // Typing and a new line: the rect of the plain glide.
+    for ([_][4]f32{ .{ 10, 0, 10, cell_h }, .{ 0, cell_h, 10, cell_h }, .{ 20, 0, 10, cell_h } }) |to| {
+        var steps: usize = 0;
+        while (steps <= 10) : (steps += 1) {
+            const t = d * @as(f64, @floatFromInt(steps)) / 10.0;
+            try testing.expectEqual(CursorGlide.rectAt(from, to, t), CursorGlide.morphAt(from, to, t, cell_h));
+        }
+    }
+
+    // A faster move (farther in the same time) stretches more, up to the
+    // limit.
+    const t = d * 0.3;
+    const short = CursorGlide.morphAt(from, .{ 40, 0, 10, cell_h }, t, cell_h);
+    const medium = CursorGlide.morphAt(from, .{ 80, 0, 10, cell_h }, t, cell_h);
+    const long = CursorGlide.morphAt(from, .{ 2000, 0, 10, cell_h }, t, cell_h);
+    try testing.expect(short[2] > 10 and short[2] < medium[2] and medium[2] < long[2]);
+    try testing.expect(long[2] <= 10 * CursorGlide.morph_max_stretch + 0.001);
+
+    // A vertical move stretches the height and thins the width.
+    const down = CursorGlide.morphAt(from, .{ 0, 400, 10, cell_h }, t, cell_h);
+    try testing.expect(down[3] > cell_h and down[2] < 10);
+    try testing.expectApproxEqAbs(@as(f32, 5), down[0] + down[2] / 2, 0.001);
+
+    // A bar keeps at least a pixel of width.
+    const bar: [4]f32 = .{ 0, 0, 2, cell_h };
+    const bar_down = CursorGlide.morphAt(bar, .{ 0, 400, 2, cell_h }, t, cell_h);
+    try testing.expect(bar_down[3] > cell_h and bar_down[2] >= 1);
+}
