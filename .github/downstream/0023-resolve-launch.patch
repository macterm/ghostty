From 198d1754216f846eb1d0c292609e7305a4e5e239 Mon Sep 17 00:00:00 2001
From: Ethan Lee <ethantlee21@gmail.com>
Date: Wed, 11 Nov 2026 11:57:33 -0500
Subject: [PATCH] embedded: resolve a surface's launch (argv, env, folder) with
 no process, so that a host that runs the child itself gets the shell
 integration

A manual surface runs no child, so libghostty no longer resolved the shell
for it. ghostty_launch_resolve takes the options of ghostty_surface_new and
returns what the exec backend would run: the command wrapper, the login(1)
wrapping of macOS, the shell integration, TERM and the other variables of
libghostty, the env of the config and the folder. It runs the code of
Exec.init and starts nothing. ghostty_launch_free frees the result.
---
 include/ghostty.h      |  19 +++++
 src/apprt/embedded.zig | 161 ++++++++++++++++++++++++++++++++----
 src/termio/Exec.zig    | 181 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 343 insertions(+), 18 deletions(-)

diff --git a/include/ghostty.h b/include/ghostty.h
index b1b740168..645f773b3 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -557,6 +557,16 @@ typedef struct {
   ghostty_surface_manual_resize_cb GHOSTTY_NULLABLE manual_resize;
 } ghostty_surface_config_s;
 
+// A resolved launch, see ghostty_launch_resolve.
+typedef struct {
+  const char* const* argv;
+  size_t argv_count;
+  const ghostty_env_var_s* env;
+  size_t env_count;
+  const char* GHOSTTY_NULLABLE cwd;
+  void* GHOSTTY_NULLABLE internal;
+} ghostty_launch_s;
+
 typedef struct {
   uint16_t columns;
   uint16_t rows;
@@ -1254,6 +1264,15 @@ GHOSTTY_API void ghostty_surface_draw(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_set_content_scale(ghostty_surface_t, double, double);
 GHOSTTY_API void ghostty_surface_set_focus(ghostty_surface_t, bool);
 GHOSTTY_API void ghostty_surface_set_occlusion(ghostty_surface_t, bool);
+// Resolve what ghostty_surface_new would run in a pty for these options, and
+// start nothing: the command, the command wrapper, the login(1) wrapping of
+// macOS, the shell integration, the environment and the folder. For a manual
+// surface, whose host starts the process. Returns false on failure. Free the
+// result with ghostty_launch_free, one time, on the same struct (do not copy it).
+GHOSTTY_API bool ghostty_launch_resolve(ghostty_app_t,
+                                        const ghostty_surface_config_s*,
+                                        ghostty_launch_s*);
+GHOSTTY_API void ghostty_launch_free(ghostty_launch_s*);
 GHOSTTY_API void ghostty_surface_feed(ghostty_surface_t,
                                       const uint8_t*,
                                       uintptr_t);
